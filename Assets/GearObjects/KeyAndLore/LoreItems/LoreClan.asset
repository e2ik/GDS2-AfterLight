  ItemID: LORE_CLAN_EMBER_ACCORD
  UIName: The Ember Accord
  UISprite: {fileID: 21300000, guid: 6cca983949cb04cc7b34cca65f0cabf4, type: 3}
  Deletable: 1
  SortOrder: 0
  maxCommonValue: 0
