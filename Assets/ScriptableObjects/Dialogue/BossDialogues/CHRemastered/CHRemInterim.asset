  lines:
  - speaker: {fileID: 11400000, guid: 5c4fc42747594ab458e2d6f4a70e4d2b, type: 2}
    text: You fight with much more passion than before
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I dont understand...
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: Why are you hunting me?
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: Is it because I am human
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: Why do you hunt humans?
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 1
  - speaker: {fileID: 11400000, guid: 5c4fc42747594ab458e2d6f4a70e4d2b, type: 2}
    text: What gave you the impression that I hunt...
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 5c4fc42747594ab458e2d6f4a70e4d2b, type: 2}
    text: HUMANS
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 1
    textSpeed: 0.2
    effect: 2
  - speaker: {fileID: 11400000, guid: 5c4fc42747594ab458e2d6f4a70e4d2b, type: 2}
    text: However you are certainly worth hunting
    overrideSpeakerName: 0
    speakerNameOverride: 
