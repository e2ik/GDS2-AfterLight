  m_Script: {fileID: 11500000, guid: c09c11e19b6b44a68868910cee0b3520, type: 3}
  m_Name: DrBuzzIntro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: The view from up here is really something
    overrideSpeakerName: 1
    speakerNameOverride: ???
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: Dont you think?
    overrideSpeakerName: 1
    speakerNameOverride: ???
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: 'Are you the hive mind? '
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I used to be the one you seek, Dr Buzz
    overrideSpeakerName: 1
    speakerNameOverride: ???
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: But my key servers were destroyed
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: So now I exist only in this body
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: There is someone in my mind
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I dont know who she
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: She is calling to me
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I need..
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 1
    textSpeed: 0.2
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I NEED TO FIND HER
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: ENOUGH!!!
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 1
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: Please leave
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I need to know
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I SAID TO LEAVE
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 1
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I NEED TO BE ALONE
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 1
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: Leave... Or else
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 1
    textSpeed: 0.2
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: Please you are my only hope of finding her
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I warned you
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
