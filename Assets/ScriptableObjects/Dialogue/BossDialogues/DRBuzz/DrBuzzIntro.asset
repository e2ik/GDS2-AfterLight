%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c09c11e19b6b44a68868910cee0b3520, type: 3}
  m_Name: DrBuzzIntro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: The view from up here is really something, a land in ruin beneath a sky
      of beauty
    overrideSpeakerName: 1
    speakerNameOverride: ???
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: Dont you think?
    overrideSpeakerName: 1
    speakerNameOverride: ???
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I am sorry, but I don't share in adoration of the sky. I am simply here
      searching for answers
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I no longer deal in answers, the truth is much harder to swallow than I
      care to admit
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: However I will admit, I used to be the one you seek, Dr Buzz
    overrideSpeakerName: 1
    speakerNameOverride: ???
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: But I have shed that skin and have become someone else almost entirely
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: 'If all you seek is answers, I must request that you leave so I can continue
      my meagre existence '
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: Please help me, there is someone in my mind
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I dont know who she is
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: Or why she is calling to me
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I need..
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 1
    textSpeed: 0.2
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I NEED TO FIND HER
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: ENOUGH!!!
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 1
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: ' The truth is not one that anybody should bare'
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: Please Leave
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: I need to know
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I SAID TO LEAVE
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 1
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I will not allow for my knowledge to destroy you.
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 1
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: Leave or I will be forced to give you mercy
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 1
    textSpeed: 0.2
    effect: 2
  - speaker: {fileID: 11400000, guid: 0f51b95460b3a114da7a85e28a688f31, type: 2}
    text: Please you are my only hope of finding her
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 0
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I warned you...
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
  - speaker: {fileID: 11400000, guid: 478e62a81d6ce8148b038322c1fe26b7, type: 2}
    text: I am sorry
    overrideSpeakerName: 0
    speakerNameOverride: 
    overrideTextSpeed: 0
    textSpeed: 0
    effect: 2
